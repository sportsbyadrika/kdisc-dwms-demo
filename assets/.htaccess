# Static assets only — nothing in here is ever executed.
Options -ExecCGI -Indexes

<FilesMatch "(?i)\.(php|php[0-9]*|phtml|phps|phar|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pl .py .cgi

# ---------------------------------------------------------------------------
# DWMS 2.0 environment
#
# Copy this file to .env on the server and fill in the real values:
#     cp .env.example .env
#
# .env is never committed and is denied by .htaccess, so it is not readable
# over the web. Keep it that way — it holds the database password.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME="DWMS 2.0"
APP_TAGLINE="Digital Workforce Management System"

# Leave empty when the site is served from a domain or sub-domain root, e.g.
# https://dwms.kdiscmis.org.in. Set to "/dwms" only if it lives in a sub folder.
APP_BASE_URL=

# Never leave this true on a live site: it prints file paths in error messages.
APP_DEBUG=false

APP_TIMEZONE="Asia/Kolkata"
APP_ORG="Kerala Development and Innovation Strategic Council"
APP_ORG_SHORT="K-DISC"

# --- database --------------------------------------------------------------
# On cPanel the user and database are both prefixed with the account name,
# for example shooting_dwms and shooting_dwmsuser.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shooting_dwms
DB_USER=shooting_dwmsuser
DB_PASS="change-me"
DB_CHARSET=utf8mb4

# --- mail ------------------------------------------------------------------
MAIL_FROM="no-reply@dwms.kdiscmis.org.in"
MAIL_FROM_NAME="DWMS 2.0"

# true  -> one-time passwords are shown on screen (demonstrations only)
# false -> one-time passwords are e-mailed and never displayed
MAIL_DEMO_OTP=true

# --- security --------------------------------------------------------------
SESSION_NAME=dwms_session
# Seconds of inactivity before a session expires (7200 = 2 hours).
SESSION_TTL=7200
# Largest upload accepted, in megabytes. Keep at or below the host's
# upload_max_filesize and post_max_size.
MAX_UPLOAD_MB=5

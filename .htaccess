# DWMS 2.0 - front controller / clean URLs (no file extensions)
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the project lives in a sub folder, set it here e.g. RewriteBase /dwms/
    # RewriteBase /

    # Force trailing-slash removal (except the site root)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Never rewrite real files (assets, uploads) or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect application internals
<FilesMatch "\.(sql|md|json|lock|log)$">
    Require all denied
</FilesMatch>

ErrorDocument 404 /index.php
